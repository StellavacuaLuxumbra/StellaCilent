# ============================================================
# Stella Client (SunCat-based) .gitignore
# 目的：防止构建产物 / 依赖库 / 参考项目把仓库撑到无法上传
# ============================================================

# === Build outputs ===
build/
out/
bin/
*.class
*.o
*.obj
*.a
*.lib
*.exe
*.dll
*.so
*.dylib

# === Archives / large binaries ===
*.jar
*.war
*.ear
*.zip
*.7z
*.rar
*.tar
*.tar.gz

# Keep gradle wrapper jar (small, needed to run ./gradlew)
!**/gradle/wrapper/gradle-wrapper.jar

# === Gradle ===
.gradle/
**/.gradle/

# === CMake (cilent) ===
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# === Generated compile helpers ===
executer/compile_args.txt
executer/cp.txt
executer/files.txt

# === Dependency libs (baritone/sodium/malilib... 手动放置，不入库) ===
stella/lib/
othercilent/**/lib/
othercilent/**/suncat.zip

# === Reference / upstream copies (源码已复制到 stella/) ===
othercilent/
temp/

# === IDE ===
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
*.launch
.factorypath

# === OS ===
.DS_Store
Thumbs.db
desktop.ini

# === Minecraft runtime ===
run/
runs/
logs/
crash-reports/
replay/

# === Local notes ===
*.log
